# ===========================================
# API CONFIGURATION
# ===========================================
# CRITICAL: ARB_BASE_URL is provided by ARB - use this for the exact endpoint URL
# This takes precedence over ARB_API_URL and ARB_SANDBOX_URL
# Format: https://securepayments.alrajhibank.com.sa (no trailing slash)
ARB_BASE_URL=https://digitalpayments.alrajhibank.com.sa

# ===========================================
# API ENDPOINTS (Test Environment)
# ===========================================
# TEST ENVIRONMENT ENDPOINTS (from ARB):
# - Bank Hosted/iFrame/JS Widget Transactions: /pg/payment/hosted.htm
# - Merchant Hosted/Supporting Transactions (inquiry, refund, void, capture): /pg/payment/tranportal.htm
# 
# Payment Token Generation API endpoint path
ARB_TOKEN_ENDPOINT_PATH=/pg/payment/hosted.htm
# Supporting Transactions endpoint (inquiry, refund, void, capture)
ARB_SUPPORTING_TRANSACTIONS_ENDPOINT=/pg/payment/tranportal.htm
# Legacy support (will use ARB_TOKEN_ENDPOINT_PATH if not set)
ARB_TOKEN_GEN_ENDPOINT=${ARB_TOKEN_ENDPOINT_PATH}

# Environment-specific URLs (fallback if ARB_BASE_URL not set)
ARB_API_URL=https://digitalpayments.alrajhibank.com.sa
ARB_SANDBOX_URL=https://sandbox.alrajhibank.com.sa
ARB_CERTIFICATION_URL=https://securepayments.alrajhibank.com.sa
ARB_ENVIRONMENT=production

# Payment Page URLs (constructed from ARB_BASE_URL automatically)
# Format: {ARB_BASE_URL}/pg/paymentpage.htm?PaymentID={paymentId}
# Legacy support (not needed if using ARB_BASE_URL)
ARB_PAYMENT_PAGE_URL=https://digitalpayments.alrajhibank.com.sa/pg/paymentpage.htm
ARB_SANDBOX_PAYMENT_PAGE_URL=https://sandbox.alrajhibank.com.sa/pg/paymentpage.htm

