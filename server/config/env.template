# ===========================================
# DRINKMATE SECURE ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and update with your actual values
# NEVER commit the actual .env file to version control

# ===========================================
# SERVER CONFIGURATION
# ===========================================
NODE_ENV=production
PORT=3000

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
# Generate strong JWT secret (minimum 32 characters)
JWT_SECRET=your_jwt_secret_here_minimum_32_characters
SESSION_SECRET=your_session_secret_here_minimum_32_characters
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d

# Rate limiting configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# MongoDB Atlas
MONGODB_URI=your_mongodb_connection_string_here

# ===========================================
# URL CONFIGURATION
# ===========================================
# Frontend URL (where customers access the website)
FRONTEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# Backend URL (where the API server is running)
BACKEND_URL=http://localhost:3000
API_URL=${BACKEND_URL}

# Base URL (alias for frontend, used in some places)
DRINKMATE_BASE_URL=${FRONTEND_URL}

# ===========================================
# CLOUDINARY CONFIGURATION
# ===========================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ===========================================
# EMAIL CONFIGURATION
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email_address
SMTP_PASS=your_app_password

# Alternative email variables (for backward compatibility)
EMAIL_USER=${SMTP_USER}
EMAIL_PASS=${SMTP_PASS}

# ===========================================
# PAYMENT GATEWAY CONFIGURATION
# ===========================================
# Tap Payment Gateway
TAP_API_KEY=your_tap_api_key
TAP_SECRET_KEY=your_tap_secret_key
TAP_MERCHANT_ID=your_tap_merchant_id
TAP_ENVIRONMENT=production

