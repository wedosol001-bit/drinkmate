# ARB (Al Rajhi Bank) Payment Gateway
# ===========================================
# MERCHANT PORTAL LOGIN CREDENTIALS
# ===========================================
# These credentials are for logging into the ARB Merchant Portal:
# https://securepayments.alrajhibank.com.sa/mrchptl/merchant.htm
# After logging in, download the API credentials (Tranportal ID, Password, Resource Key)
ARB_MERCHANT_PORTAL_URL=https://securepayments.alrajhibank.com.sa/mrchptl/merchant.htm
ARB_INSTITUTION_ID=ARB
ARB_MERCHANT_ID=600002784
ARB_MERCHANT_USER_ID=AQUA600002784
ARB_MERCHANT_PASSWORD=#Welcome123
ARB_MERCHANT_PROFILE_PASSWORD=#Aqua123

# ===========================================
# API CREDENTIALS (Download from Merchant Portal)
# ===========================================
# IMPORTANT: After logging into the merchant portal, download these credentials:
# 1. Tranportal ID
# 2. Tranportal Password
# 3. Resource Key (for AES encryption)
# These are different from the merchant portal login credentials above
ARB_TRANPORTAL_ID=your_tranportal_id_from_portal
ARB_TRANPORTAL_PASSWORD=your_tranportal_password_from_portal
ARB_RESOURCE_KEY=your_resource_key_from_portal

# Legacy support (will use TRANPORTAL if not set)
ARB_PASSWORD=${ARB_TRANPORTAL_PASSWORD}

# ===========================================
# API CONFIGURATION
# ===========================================
# Payment Token Generation API endpoint (verify exact path from ARB documentation)
ARB_TOKEN_GEN_ENDPOINT=/paymentToken
# Base URLs
ARB_API_URL=https://securepayments.alrajhibank.com.sa
ARB_SANDBOX_URL=https://sandbox.alrajhibank.com.sa
ARB_ENVIRONMENT=sandbox
# Payment Page URLs
ARB_PAYMENT_PAGE_URL=https://securepayments.alrajhibank.com.sa/pg/paymentpage.htm
ARB_SANDBOX_PAYMENT_PAGE_URL=https://sandbox.alrajhibank.com.sa/pg/paymentpage.htm


