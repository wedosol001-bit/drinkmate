# ===========================================
# DRINKMATE FRONTEND ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env.local and update with your actual values
# NEVER commit the actual .env.local file to version control

# ===========================================
# API CONFIGURATION
# ===========================================
# Backend API URL (where the backend server is running)
# For local development: http://localhost:3000
# For production: Your production backend URL
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=${NEXT_PUBLIC_API_URL}

# ===========================================
# SITE CONFIGURATION
# ===========================================
# Frontend site URL (where customers access the website)
# For local development: http://localhost:3001
# For production: Your production frontend URL
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_BASE_URL=${NEXT_PUBLIC_SITE_URL}

# ===========================================
# ENVIRONMENT
# ===========================================
NODE_ENV=development
